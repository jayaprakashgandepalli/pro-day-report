generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  employeeId       String    @unique
  name             String
  password         String
  role             String    @default("EMPLOYEE") // EMPLOYEE, TEAM_LEADER, ADMIN, TELECALLER, COLLEGE
  isActive         Boolean   @default(true)
  
  // New fields for COLLEGE role
  allowedGroups    String[]  @default([])
  allowedLocations String[]  @default([])
  
  // Field for TELECALLER role to restrict visibility to specific employees
  assignedEmployees String[] @default([])
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  students         Student[]
  visitsCreated    Visit[]   @relation("UserVisits")
  admittedStudents Student[] @relation("CollegeAdmissions")
}

model ConfigValue {
  id        String        @id @default(cuid())
  type      String        // 'DISTRICT', 'MANDAL', 'VILLAGE', 'GROUP', 'STATUS', 'SCHOOL', 'OCCUPATION', 'STUDY_INTEREST', 'FEE_BEARABLE'
  value     String
  parentId  String?       // Used for hierarchy (e.g. Village -> Mandal -> District)
  parent    ConfigValue?  @relation("ConfigHierarchy", fields: [parentId], references: [id])
  children  ConfigValue[] @relation("ConfigHierarchy")
  strength  Int?          @default(0) // Used for school strength
  grade     String?       // Used for school grade (e.g., A+, A, B)
  createdAt DateTime      @default(now())

  @@index([type])
  @@index([parentId])
}

model Student {
  id                String   @id @default(cuid())
  employeeId        String
  employee          User     @relation(fields: [employeeId], references: [employeeId])
  studentName       String
  fatherName        String?
  occupation        String?
  address           String?
  phone             String
  whatsapp          String?
  gender            String?
  group             String
  visitNumber       String?
  
  // New Hierarchical Location Fields (Can store the ConfigValue names directly for easy querying/PDF)
  district          String?
  mandal            String?
  village           String?
  
  schoolName        String?
  schoolArea        String?
  marks             String?
  remarks           String?
  leadStatus        String?  @default("New")
  
  // New Fields
  studyInterestedAt String?
  educationStage    String?
  ableToBearFee     String?
  nextFollowUpDate  DateTime?
  nextFollowUpType  String?
  doorstepCompleted Boolean  @default(false)
  
  // Admission Tracking
  joinedCollegeId   String?
  joinedCollege     User?    @relation("CollegeAdmissions", fields: [joinedCollegeId], references: [employeeId])
  applicationNumber String?
  admissionDate     DateTime?
  
  visits            Visit[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Student Login & Assessment Fields
  password           String?
  registrationStatus String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  registeredBy       String   @default("EMPLOYEE") // EMPLOYEE, SELF
  
  testResponses      StudentTestResponse[]
  assessmentReport   AssessmentReport?

  @@index([schoolName])
  @@index([mandal])
  @@index([employeeId])
}

model Visit {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  addedById        String?
  addedBy          User?     @relation("UserVisits", fields: [addedById], references: [employeeId])
  
  visitDate        DateTime  @default(now())
  remarks          String
  nextFollowUpDate DateTime?
  nextFollowUpType String?
  createdAt        DateTime  @default(now())
}

// ==========================================
// STUDENT ASSESSMENT & CAREER GUIDANCE MODELS
// ==========================================

model Question {
  id            String   @id @default(cuid())
  module        String   @default("1") // "1" for Group Clarity, "2" for Study Discipline, "3" for Screen Time, "4" for Family, "5" for Career Readiness
  order         Int      @default(1)
  text          String
  options       Option[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  
  studentResponses StudentTestResponse[]
}

model Option {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  score       Int      @default(0) // Used to calculate aptitude/behavior score
  traitPoints String?  // e.g., 'SCIENCE:5, MATH:2' or JSON string to weight different traits
}

model StudentTestResponse {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId    String
  createdAt   DateTime @default(now())
  
  @@unique([studentId, questionId])
}

model AssessmentReport {
  id               String   @id @default(cuid())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  recommendedGroup String?  // e.g., "MPC", "BiPC"
  recommendedJobs  String?  // e.g., "Software Engineer, Doctor"
  dailyActivities  String?  @db.Text
  identifiedFlaws  String?  @db.Text
  advice           String?  @db.Text
  
  // Modular Scores
  disciplineScore      Int?
  screenTimeScore      Int?
  familyAttitudeScore  Int?
  careerClarityScore   Int?
  moduleInsights       Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
